From adf2008dd67c76dded4db10854646329911654a9 Mon Sep 17 00:00:00 2001
From: AdarshGrewal <adarshgrewal@gmail.com>
Date: Tue, 5 Aug 2025 13:49:12 +0530
Subject: [PATCH] vendor: config: Exclude AOSP audio on GMS builds

Change-Id: I094e1cb584fc31cf510b96c1e4dbcd7240b3fad3
---
 config/common_mobile.mk | 2 ++
 config/telephony.mk     | 2 ++
 2 files changed, 4 insertions(+)

diff --git a/config/common_mobile.mk b/config/common_mobile.mk
index 38003df24..2cfd6fd01 100644
--- a/config/common_mobile.mk
+++ b/config/common_mobile.mk
@@ -1,6 +1,7 @@
 # Inherit common mobile Lineage stuff
 $(call inherit-product, vendor/lineage/config/common.mk)
 
+ifneq ($(WITH_GMS),true)
 # Include AOSP audio files
 $(call inherit-product-if-exists, frameworks/base/data/sounds/AudioPackage14.mk)
 include vendor/lineage/config/aosp_audio.mk
@@ -12,6 +13,7 @@ include vendor/lineage/config/lineage_audio.mk
 PRODUCT_PRODUCT_PROPERTIES += \
     ro.config.notification_sound=Argon.ogg \
     ro.config.alarm_alert=Hassium.ogg
+endif
 
 # Apps
 PRODUCT_PACKAGES += \
diff --git a/config/telephony.mk b/config/telephony.mk
index 688184679..f5407a1ef 100644
--- a/config/telephony.mk
+++ b/config/telephony.mk
@@ -16,9 +16,11 @@ PRODUCT_PACKAGES += \
     messaging \
     Stk
 
+ifneq ($(WITH_GMS),true)
 # Default ringtone
 PRODUCT_PRODUCT_PROPERTIES += \
     ro.config.ringtone=Orion.ogg
+endif
 
 # Tethering - allow without requiring a provisioning app
 # (for devices that check this)
-- 
2.53.0

